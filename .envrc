# ============================================================================
# Shortener Server 环境变量配置
# 由 direnv 自动加载，覆盖 config.toml 中的默认值。
# 嵌套配置键使用双下划线 __ 分隔（config crate 的 Environment::separator("__")）。
# 敏感项请替换为实际值并妥善保管（.envrc 已被 git 跟踪，避免提交真实密钥）。
# ============================================================================

# ===== [server] 服务器配置 =====
SERVER__ADDRESS="0.0.0.0:8080"
SERVER__TRUSTED_PLATFORM=""
SERVER__SHORT_URL="http://localhost:8080"   # 短址专用域名（可选，未设置时从监听地址推断，通配地址回退 localhost）
SERVER__API_KEY="your-secret-api-key-change-me"   # 生成：openssl rand -base64 32

# ===== [slug] 短链接生成 =====
SLUG__LENGTH="6"
SLUG__ALPHABET="0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"

# ===== [admin] 管理员账号（密码登录通道）=====
ADMIN__USERNAME="admin"
ADMIN__PASSWORD_HASH='$argon2id$v=19$m=19456,t=2,p=1$...'   # 生成：shortener-server hash-password

# ===== [oidc] OIDC 单点登录（可选，enabled 为总开关）=====
OIDC__ENABLED="false"         # false 时 OIDC 登录不可用
OIDC__ISSUER=""
OIDC__CLIENT_ID=""
OIDC__CLIENT_SECRET=""        # 兼容回退：OIDC_CLIENT_SECRET（__ 形式优先）
# 回调地址无需配置：服务根据请求 Host 头自动推导为 https://<域名>/api/oidc/callback
OIDC__ALLOW_EMAILS="[]"
OIDC__ALLOW_SUBJECTS="[]"

# ===== [database] 数据库 =====
DATABASE__URL="sqlite://data/shortener.db?mode=rwc"   # 引擎由 scheme 推断；兼容回退：DATABASE_URL
DATABASE__LOG_LEVEL="1"

# ===== [cache] 缓存（可选，启用时需 CACHE__URL）=====
CACHE__ENABLED="false"
CACHE__URL="redis://localhost:6379/0"                # 兼容回退：CACHE_URL
CACHE__EXPIRE="3600"
CACHE__PREFIX="shorten:"

# ===== [geoip] GeoIP（可选，需 ip2region 数据库文件）=====
GEOIP__ENABLED="false"
GEOIP__TYPE="ip2region"
GEOIP__IP2REGION__PATH="data/ip2region.xdb"
GEOIP__IP2REGION__MODE="vector"
GEOIP__IP2REGION__VERSION="4"

# ===== [logging] 日志 =====
LOGGING__LEVEL="info"
LOGGING__FORMAT="json"
LOGGING__WITH_TIMESTAMP="true"
LOGGING__WITH_TARGET="true"
LOGGING__WITH_THREAD_IDS="false"
LOGGING__WITH_THREAD_NAMES="false"
LOGGING__WITH_FILE="false"
LOGGING__WITH_LINE_NUMBER="false"
LOGGING__WITH_ANSI="true"

# ===== JWT（登录签发令牌必需，JWT_SECRET 与 JWT_SECRET_FILE 二选一）=====
JWT_SECRET=""                 # 生成：openssl rand -base64 48
JWT_SECRET_FILE=""            # 或以文件方式挂载密钥路径

dotenv_if_exists
